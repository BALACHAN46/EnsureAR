# Copy to .env.local for local overrides (never commit real values).
#
# Leave VITE_API_PROXY_TARGET / VITE_API_BASE_URL unset to use the defaults
# below, which work out of the box against `dotnet run` from EnsureAR_API.

# Used only by vite.config.js's dev server proxy (server-side, not bundled).
VITE_API_PROXY_TARGET=http://localhost:5278

# Used by the browser app itself (src/services/config.js) to resolve
# media (GLB/thumbnail) URLs returned by the API. Set this to the API's
# public URL in production.
VITE_API_BASE_URL=http://localhost:5278
